<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="VisionOS.uss" />
    
    <ui:VisualElement name="root" class="root-container">
        
        <!-- Panel 1: Checking Devices -->
        <ui:VisualElement name="pnl-checking-devices" class="glass-panel animated-panel" style="width: 600px; height: 500px; align-items: center; justify-content: flex-start;">
            <!-- Header removed or kept empty to match "clean" look if checking devices list is self-sufficient, 
                 but keeping a container for the list. 
                 Screenshots show a list in void, but we use a glass panel as requested locally or just a container. 
                 User request said: "Utilise .glass-panel." for Checking Devices. -->
             
            <ui:ScrollView name="devices-list" style="width: 100%; flex-grow: 1; flex-shrink: 1; min-height: 0;" />
            <ui:Button name="btn-start" text="Commencer" class="btn-action-green" style="display: none; flex-shrink: 0; height: 56px; width: 100%; margin-top: 12px;" />
            <ui:Label name="lbl-press-a" text="" style="flex-shrink: 0; margin-top: 12px; font-size: 20px; color: rgb(46, 204, 113); -unity-font-style: bold;" />
        </ui:VisualElement>

        <!-- Panel 2: Calibration Overlay (Fullscreen) -->
        <ui:VisualElement name="pnl-calibration-overlay" class="animated-panel" style="position: absolute; width: 100%; height: 100%;">
            <ui:Label name="lbl-instruction" text="Appuyez une fois sur la gâchette dans le cercle pour calibrer" class="sub-header" style="position: absolute; top: 30%; width: 100%; -unity-text-align: middle-center;" />
     
            <ui:VisualElement name="calibration-marks-container" style="position: absolute; width: 100%; height: 100%;" />
        </ui:VisualElement>

        <!-- Panel 3: Validation Footer -->
        <ui:VisualElement name="pnl-validation-footer" class="animated-panel" style="position: absolute; top: 50px; flex-direction: row; gap: 40px;">
            <ui:Button name="btn-refine" tooltip="Ajuster" text="Ajuster" class="btn-action-blue" />
            <ui:Button name="btn-start-over" tooltip="Recommencer" text="Recommencer" class="btn-action-red" />
            <ui:Button name="btn-validate" tooltip="Valider la calibration" text="Valider" class="btn-action-green" />
        </ui:VisualElement>

        <!-- Panel 4: Popup Launch -->
        <ui:VisualElement name="pnl-popup-launch" class="animated-panel" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center;">
            <ui:VisualElement class="glass-panel" style="padding: 40px; align-items: center; width: 550px; max-width: 90%;">
        
                <ui:Label text="LANCEMENT" class="sub-header" style="margin-bottom: 20px; opacity: 0.7; font-size: 14px; letter-spacing: 2px;" />
                <ui:VisualElement style="height: 1px; width: 100%; background-color: rgba(255,255,255,0.1); margin-bottom: 30px;" />

                <ui:VisualElement style="width: 60px; height: 60px; background-color: rgba(46, 204, 113, 0.2); border-radius: 12px; margin-bottom: 20px; justify-content: center; align-items: center; border-width: 1px; border-color: rgba(46, 204, 113, 0.5);">
                    <ui:VisualElement class="icon-status-ok" style="width: 30px; height: 30px;" />
                </ui:VisualElement>
        
                <ui:Label text="Calibration trouvée" class="header-text" style="font-size: 24px; margin-bottom: 10px;" />
                <ui:Label text="Voulez-vous lancer le jeu ou recalibrer ?" class="sub-header" style="white-space: normal; -unity-text-align: middle-center; margin-bottom: 40px; font-size: 16px;" />

                <ui:VisualElement style="flex-direction: row; gap: 20px; width: 100%; justify-content: center; flex-shrink: 0;">
            
                    <!-- Même DA que les popups GraffWall : refus en bouton nu à gauche, action
                         positive en vert translucide (.popup-btn-green) à droite. -->
                    <ui:Button name="btn-popup-recalibrate" tooltip="Recalibrer" class="sidebar-button" style="flex-grow: 1; flex-shrink: 1; width: auto; justify-content: center; margin-bottom: 0;">
                        <ui:Label text="Recalibrer" style="color: white; pointer-events: none;" />
                    </ui:Button>

                    <ui:Button name="btn-popup-launch" tooltip="Lancer le jeu" class="sidebar-button popup-btn-green" style="flex-grow: 1; flex-shrink: 1; width: auto; justify-content: center; margin-bottom: 0;">
                        <ui:Label text="Lancer" style="color: white; -unity-font-style: bold; pointer-events: none;" />
                    </ui:Button>
                    
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
