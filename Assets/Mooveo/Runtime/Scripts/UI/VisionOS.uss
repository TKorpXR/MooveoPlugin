:root {
    --glass-bg-top: rgba(255, 255, 255, 0.08);
    --glass-bg-bottom: rgba(255, 255, 255, 0.01);
    --border-bright: rgba(255, 255, 255, 0.4);
    --border-dim: rgba(255, 255, 255, 0.1);
    --text-color: rgb(238, 238, 238);
    --radius-l: 30px;
    --font-size-header: 32px;
}

.root-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    overflow: visible;
    pointer-events: none;
}

.glass-panel {
    background-color: rgba(40, 40, 40, 0.6);
    border-radius: 40px;
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.4);
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.1);
    padding: 24px;
}

.header-text {
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.sub-header {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 10px;
}

.icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: white;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
}

.icon-back {
    background-image: resource("Icons/arrow_back");
}

.icon-close {
    background-image: resource("Icons/close");
}

.icon-brush {
    background-image: resource("Icons/brush");
}

.icon-undo {
    background-image: resource("Icons/undo");
}

.icon-check {
    background-image: resource("Icons/check");
}

.icon-trash {
    background-image: resource("Icons/delete");
}

.icon-gallery {
    background-image: resource("Icons/gallery");
}

.icon-banner {
    background-image: resource("Icons/banner");
}

.icon-preview {
    background-image: resource("Icons/eye");
}

.icon-capture {
    background-image: resource("Icons/camera");
}

.icon-folder {
    background-image: resource("Icons/folder");
}

.icon-print {
    background-image: resource("Icons/print");
}

.icon-save {
    background-image: resource("Icons/save");
}

/* Deplacer un objet pose. La croix a quatre fleches dit le geste elle-meme, la ou un engrenage
   demandait de savoir ce qu'il recouvrait. */
.icon-drag {
    background-image: resource("Icons/Mooveo/drag_pan_100dp_FFFFFF_FILL0_wght400_GRAD0_opsz48");
}

.icon-refresh {
    background-image: resource("Icons/refresh");
}

/* Icones "cadrage" des boutons de capture (menu Stickers) : deux ou quatre coins en L, comme les
   repères de cadrage de l'appareil photo iOS — un coin = deux bordures visibles sur quatre. */
.capture-icon {
    width: 16px;
    height: 16px;
    position: relative;
}
.capture-bracket {
    position: absolute;
    width: 7px;
    height: 7px;
    border-color: rgb(255, 255, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.capture-bracket--tl { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; }
.capture-bracket--tr { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; }
.capture-bracket--bl { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; }
.capture-bracket--br { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; }
.icon-color-picker {
    background-image: resource("Icons/palett");
}
.icon-lock-open {
    background-image: resource("Icons/Mooveo/unlock");
}
.icon-lock-closed {
    background-image: resource("Icons/Mooveo/lock");
}

.vision-icon-button {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    transition-duration: 0.2s;
}

.vision-icon-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
    scale: 1.1;
}

.vision-icon-button:active {
    background-color: rgba(255, 255, 255, 0.4);
    scale: 0.95;
}

.vision-icon-button .icon {
    width: 28px;
    height: 28px;
    margin-right: 0;
    -unity-background-image-tint-color: white;
}

.button-primary {
    background-color: rgba(255, 255, 255, 0.15);
}

.button-destructive {
    background-color: rgba(255, 69, 58, 0.2);
}

.button-destructive:hover {
    background-color: rgba(255, 69, 58, 0.4);
}

.segmented-control {
    background-color: rgba(118, 118, 128, 0.24);
    border-radius: 9px;
    padding: 2px;
    flex-direction: row;
}

.top-tab-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 7px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    min-width: 100px;
    height: 32px;
    margin: 0;
    -unity-font-style: normal;
    transition-duration: 0.1s;
}

.top-tab-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.top-tab-button.active {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

.sidebar-container {
    width: auto;
    min-width: 100px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 16px;
    padding-right: 16px;
}

.sidebar-panel-container {
    width: 280px;
    border-right-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 30px;
    display: flex;
    flex-direction: column;
}

.icon-gallery {
    background-image: resource("Icons/gallery");
}

.icon-banner {
    background-image: resource("Icons/banner");
}

.icon-preview {
    background-image: resource("Icons/eye");
}

.icon-capture {
    background-image: resource("Icons/camera");
}

.icon-folder {
    background-image: resource("Icons/folder");
}

.sidebar-button {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding: 12px 16px;
    border-radius: 12px;
    background-color: transparent;
    transition-duration: 0.2s;
    margin-bottom: 8px;
    min-width: 0;
}

.sidebar-button:hover {
    background-color: rgba(255, 255, 255, 0.25);
    scale: 1.05;
    border-color: rgba(255, 255, 255, 0.5);
    border-width: 1px;
}

.sidebar-button.active,
.sidebar-button:active {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 30px;
}

.grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 0;
    padding-right: 0;
    gap: 20px;
}

.grid-item {
    width: 200px;
    max-width: 240px;
    flex-grow: 1;
    height: 160px;
    margin: 0;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    transition-duration: 0.15s;
}

.brush-settings-grid-item {
    width: 160px;
    height: 160px;
    margin: 0;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    transition-duration: 0.15s;
}

.brush-settings-grid-item:hover,
.grid-item:hover {
    background-color: rgba(255, 255, 255, 0.2);
    scale: 1.05;
}

.brush-settings-grid-item.selected,
.grid-item.selected {
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.1);
}

.preview-image {
    width: 100%;
    height: 100%;
    border-radius: 10px;
}

#unified-root {
    min-height: 600px;
}

.content-area-base {
    opacity: 0;
    scale: 0.95;
    transform-origin: center left;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
    pointer-events: none;
}

.content-visible {
    opacity: 1;
    scale: 1;
    display: flex;
    margin-left: 20px;
    pointer-events: auto;
}

.fade-content {
    transition: opacity 0.2s ease-in-out;
    opacity: 1;
}

.fade-content-hidden {
    opacity: 0;
}

.drag-handle {
    width: 200px;
    height: 20px;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    position: absolute;
    bottom: -60px;
    align-self: center;
}

.drag-handle:hover {
    background-color: rgba(255, 255, 255, 0.6);
    height: 24px;
}

.brush-item {
    width: 120px;
    height: 120px;
    margin-right: 10px;
    margin-top: 0;
    margin-bottom: 0;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0;
    flex-shrink: 0;
    transition-duration: 0.1s;
}

.brush-item:hover {
    background-color: rgba(255, 255, 255, 0.3);
    scale: 1.05;
}

.brush-item.selected {
    border-width: 2px;
    border-color: rgb(10, 132, 255);
    background-color: rgba(255, 255, 255, 0.2);
}

.brush-item .preview-image {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

#palette-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 10px;
}

.color-item {
    margin-right: 0.5%;
    margin-bottom: 5px;
    border-radius: 6px;
    box-sizing: border-box;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.05);
    transition-duration: 0.1s;
}

.color-item:hover {
    scale: 1.15;
    z-index: 10;
    border-color: white;
    border-width: 3px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.color-item.selected {
    border-color: rgb(10, 132, 255);
    /* FIX ICI : Toujours 3px */
    border-width: 3px;
    scale: 1.05;
    z-index: 5;
}

#stickers-list-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 10px;
}

.sticker-item {
    width: 100px;
    height: 100px;
    margin: 10px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
    flex-grow: 0;
    -unity-background-scale-mode: scale-to-fit;

    /* Même grammaire que `.background-item` : mêmes propriétés animées, même durée. Deux grilles de
       vignettes qui ne réagissent pas pareil se lisent comme deux mécaniques différentes. */
    border-width: 0;
    transition-duration: 0.1s;
    transition-property: scale, background-color, border-color;
}

/* Pastille d'information sur une vignette : nombre d'etapes d'un pochoir, nombre de traces d'un
   objet pose. Elle etait posee par le C# depuis les pochoirs a etapes mais n'avait jamais recu de
   style — un Label nu, a cheval sur l'image. Ancree en bas, sur un fond sombre : les pochoirs sont
   des images claires, un texte blanc nu y disparait. */
.sticker-step-badge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-text-align: middle-center;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

/* Pastille « 3D » : ce pochoir porte une normale, la peinture y prendra du relief.

   En HAUT A DROITE, alors que le compteur d'etapes occupe toute la bande du BAS. Les deux se
   cumulent sur un multi-pochoir en relief, et un badge pose au meme endroit que l'autre en
   masquerait un — or ils ne disent pas la meme chose : l'un compte les couches, l'autre annonce la
   matiere.

   Meme habillage que le compteur — disque sombre, texte blanc — parce que c'est la meme famille
   d'information : une propriete du pochoir, lisible avant de l'avoir pose. Un badge de couleur
   vive se lirait comme une alerte. */
.sticker-relief-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    padding: 1px 6px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 8px;
}

.sticker-item:hover {
    scale: 1.05;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.8);
}

/* Vignette SELECTIONNEE dans l'onglet « Sur le mur ».

   Reprend a l'identique `.background-item.selected` : meme agrandissement, meme fond, meme bordure
   blanche de 3 px. Un etat « selectionne » qui ne se ressemble pas d'un menu a l'autre oblige a
   reapprendre la meme information deux fois.

   ⚠ Declaree APRES `.sticker-item:hover` : a specificite egale (une classe + une classe contre une
   classe + une pseudo-classe), c'est l'ordre qui tranche. Placee avant, le survol aurait efface la
   selection — on ne verrait plus ce qu'on a choisi au moment precis ou l'on vise ses boutons. */
.sticker-item.active {
    scale: 1.05;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

#background-list-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 10px;
}

.background-item {
    width: 220px;
    height: 124px;
    margin: 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    flex-shrink: 0;
    flex-grow: 0;
    -unity-background-scale-mode: scale-to-fill;
    transition-duration: 0.1s;
    transition-property: scale, background-color, border-color;
}

.background-item:hover {
    scale: 1.05;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.8);
}

.background-item.selected {
    scale: 1.05;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.vision-radio-classic {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 25px;
}

.vision-radio-classic .unity-radio-button {
    margin-right: 30px;
    margin-bottom: 15px;
    padding: 10px;
    align-items: center;
    background-color: transparent;
}

.vision-radio-classic .unity-radio-button__checkmark-background {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: transparent;
    margin-right: 15px;
}

.vision-radio-classic .unity-radio-button__checkmark {
    display: none;
    width: 0;
    height: 0;
    background-image: none;
    -unity-background-image-tint-color: transparent;
}

.vision-radio-classic .unity-radio-button__text {
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    margin: 0;
    padding: 0;
}

.vision-radio-classic .unity-radio-button:checked .unity-radio-button__checkmark-background {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    background-image: none;
}

.vision-radio-classic .unity-radio-button:checked .unity-radio-button__text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.vision-radio-classic .unity-radio-button:hover .unity-radio-button__text {
    color: rgb(221, 221, 221);
}

.vision-radio-classic .unity-radio-button:hover .unity-radio-button__checkmark-background {
    border-color: rgb(221, 221, 221);
}

.control-pad {
    flex-direction: row;
    flex-wrap: wrap;
    width: 150px;
    justify-content: center;
    align-self: center;
    gap: 5px;
    margin-bottom: 20px;
}

.control-button-small {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    align-items: center;
    justify-content: center;
    border-width: 0;
    transition-duration: 0.1s;
}

.control-button-small:hover {
    background-color: rgba(255, 255, 255, 0.3);
    scale: 1.1;
}

.control-button-small:active {
    background-color: rgba(255, 255, 255, 0.5);
    scale: 0.95;
}

.counter-display {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    min-width: 50px;
    -unity-text-align: middle-center;
    margin-left: 10px;
    margin-right: 10px;
}

.spinner {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.1);
    border-top-color: rgb(10, 132, 255);
    border-left-color: rgb(10, 132, 255);
}

/* Calibration UI Styles */

.device-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 60px;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
}

.device-name {
    font-size: 20px;
    color: rgb(220, 220, 220);
}

.status-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-status-ok {
    background-image: resource("Icons/check");
    -unity-background-image-tint-color: rgb(46, 204, 113);
}

.icon-status-loading {
    /* Spinner style is handled by .spinner class usually, but if we use an icon: */
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.2);
    border-top-color: white;
    /* Rotation needs to be handled in C# or via unity simpler animation if possible, or just use the .spinner class */
}

/* Calibration Points */
.calibration-point {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 40px; /* rond : cible de calibration, PAS un bouton d'action */
    /* Border handled by C# drawing */
    background-color: rgba(0, 0, 0, 0.2);
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.calibration-point-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border-width: 0;
}

.calibration-point-icon {
    width: 40px;
    height: 40px;
    opacity: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: resource("Icons/check");
    -unity-background-image-tint-color: rgb(46, 204, 113);
}

.calibration-point.valid {
    border-color: rgb(46, 204, 113);
}
.calibration-point.error {

    border-color: rgb(255, 91, 83);
}
.calibration-point.error .calibration-point-icon {
    background-image: resource("Icons/close");
    -unity-background-image-tint-color: rgb(231, 76, 60);
    opacity: 1;
}

.calibration-point.valid .calibration-point-fill {
    /* No scale or bg color needed, drawing handles it */
}

/* Validation Buttons — même langage que les "Oui" de popup (.popup-btn-green) :
   fond TRANSLUCIDE 0.35 -> 0.5 au hover, texte blanc gras. Seule la teinte change. */
.btn-action-green {
    width: 200px;
    height: 80px;
    border-radius: 12px;
    background-color: rgba(46, 204, 113, 0.35);
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5); /* meme lisere blanc que les boutons de popup */
    transition-duration: 0.2s;
}

.btn-action-green:hover {
    scale: 1.05;
    background-color: rgba(46, 204, 113, 0.5);
}

.btn-action-red {
    width: 200px;
    height: 80px;
    border-radius: 12px;
    background-color: rgba(231, 76, 60, 0.35);
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5); /* meme lisere blanc que les boutons de popup */
    transition-duration: 0.2s;
}

.btn-action-red:hover {
    scale: 1.05;
    background-color: rgba(231, 76, 60, 0.5);
}

.btn-action-blue {
    width: 200px;
    height: 80px;
    border-radius: 12px;
    background-color: rgba(10, 132, 255, 0.35);
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5); /* meme lisere blanc que les boutons de popup */
    transition-duration: 0.2s;
}

.btn-action-blue:hover {
    scale: 1.05;
    background-color: rgba(10, 132, 255, 0.5);
}

.icon-cube-green {
    /* Placeholder for the cube icon if not available, simply a colored box or use a known icon */
     background-image: resource("Icons/folder");
     -unity-background-object-fit: cover;
}

/* Animations & Transitions Refactor */
.animated-panel {
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
    opacity: 1;
    scale: 1;
    pointer-events: auto; /* Réactive les clics quand visible */
}

/* ⚠ `pointer-events` N'EXISTE PAS dans UI Toolkit (propriété CSS du web, ignorée en silence) :
   un panneau caché par sa seule opacité reste POINTABLE, enfants compris, et avale les clics
   destinés à ce qu'il recouvre. Le masquage du pointage se fait en C#
   (UICalibrationToolkit.SetPanelVisibility : visibility: hidden après le fondu). */
.animated-panel--hidden {
    opacity: 0;
    scale: 0.95; /* Léger effet de recul quand ça disparaît */
}


/* Cascade Animation for Validation Buttons */
.animated-panel .btn-action-blue,
.animated-panel .btn-action-red,
.animated-panel .btn-action-green {
    transition-property: scale, background-color, opacity, translate;
    opacity: 1;
    translate: 0 0;
}

.animated-panel--hidden .btn-action-blue,
.animated-panel--hidden .btn-action-red,
.animated-panel--hidden .btn-action-green {
    opacity: 0;
    translate: 0 20px;
}

.animated-panel .btn-action-blue { transition-delay: 0.05s; }
.animated-panel .btn-action-red { transition-delay: 0.1s; }
.animated-panel .btn-action-green { transition-delay: 0.15s; }



/* Pipette Preview */
.pipette-preview-box {
    width: 60px;
    height: 32px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    transition-property: opacity;
    transition-duration: 0.2s;
}

.pipette-preview-box--hidden {
    opacity: 0;
    display: none;
}


.tooltip-box {
    position: absolute;
    bottom: 100px;
    background-color: rgba(20, 20, 20, 0.8);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    padding: 8px 16px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
    transform-origin: bottom center;
}

.tooltip-box--hidden {
    opacity: 0;
    scale: 0.6;
    translate: 0 15px;
    pointer-events: none;
}

.tooltip-text {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
}

.tooltip-arrow {
    position: absolute;
    bottom: -6px;
    width: 12px;
    height: 12px;
    background-color: rgba(20, 20, 20, 0.8);
    left: 50%;
    translate: -50% 0;
    rotate: 45deg;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
}

.tooltip-box--bottom {
    transform-origin: top center;
}

.tooltip-box--bottom .tooltip-arrow {
    bottom: auto;
    top: -6px;
    border-bottom-width: 0px;
    border-right-width: 0px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.2);
    border-left-color: rgba(255, 255, 255, 0.2);
}

.controller-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 8px;
}

.controller-title {
    unity-font-style: bold;
    margin-bottom: 6px;
    color: white;
}

.controller-buttons {
    flex-direction: row;
    gap: 8px;
}

.controller-button {
    min-width: 80px;
    height: 32px;
}

/* ============================================================
   VISION DROPDOWN  —  Style Glassmorphism
   Utilisé par les menus déroulants de l'AccessibilityMenu
   ============================================================ */

/* Conteneur principal */
.vision-dropdown {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.15);
    padding-left: 10px;
    padding-right: 6px;
    height: 38px;
    transition-duration: 0.15s;
    transition-property: background-color, border-top-color, scale;
}

/* Texte sélectionné */
.vision-dropdown .unity-base-popup-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    color: rgb(238, 238, 238);
    font-size: 16px;
    -unity-font-style: normal;
    flex-grow: 1;
    align-self: center;
}

/* Label de la valeur */
.vision-dropdown .unity-base-popup-field__text {
    color: rgb(238, 238, 238);
    font-size: 16px;
    -unity-text-align: middle-left;
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Flèche chevron */
.vision-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.6);
    width: 14px;
    height: 14px;
    align-self: center;
    flex-shrink: 0;
}

/* Survol */
.vision-dropdown:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-top-color: rgba(255, 255, 255, 0.55);
    scale: 1.02;
}

/* Focus (cliqué / ouvert) */
.vision-dropdown:focus {
    background-color: rgba(255, 255, 255, 0.18);
    border-top-color: rgba(255, 255, 255, 0.7);
}

/* Panneau de la liste déroulante */
.vision-dropdown .unity-base-dropdown__container-outer {
    background-color: rgba(28, 28, 32, 0.92);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

/* Items de la liste */
.vision-dropdown .unity-base-dropdown__item {
    border-radius: 8px;
    padding: 8px 12px;
    color: rgb(238, 238, 238);
    font-size: 15px;
    transition-duration: 0.1s;
    background-color: transparent;
    border-width: 0;
}

.vision-dropdown .unity-base-dropdown__item:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.vision-dropdown .unity-base-dropdown__item.unity-base-dropdown__item--checked {
    background-color: rgba(255, 255, 255, 0.18);
    color: white;
    -unity-font-style: bold;
}

/* Checkmark de l'item sélectionné */
.vision-dropdown .unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.8);
    width: 14px;
    height: 14px;
    margin-right: 8px;
    flex-shrink: 0;
}

/* ============================================================
   TOAST NOTIFICATION
   ============================================================ */

.toast-container {
    position: absolute;
    bottom: 40px;
    align-self: center;
    background-color: rgba(40, 40, 40, 0.85);
    border-radius: 20px;
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.4);
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.1);
    padding: 12px 24px;
    flex-direction: row;
    align-items: center;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
    opacity: 1;
    translate: 0 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    pointer-events: none;
}

.toast--hidden {
    opacity: 0;
    translate: 0 20px;
}

.toast-icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.toast-text-container {
    flex-direction: column;
}

.toast-title {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.toast-message {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    margin: 0;
    padding: 0;
}

.toast--success {
    border-color: rgba(46, 204, 113, 0.5);
}

.toast--success .toast-icon {
    -unity-background-image-tint-color: rgb(46, 204, 113);
}

.toast--error {
    border-color: rgba(231, 76, 60, 0.5);
}

.toast--error .toast-icon {
    -unity-background-image-tint-color: rgb(231, 76, 60);
}

.toast--warning {
    border-color: rgba(241, 196, 15, 0.6);
}

.toast--warning .toast-icon {
    -unity-background-image-tint-color: rgb(241, 196, 15);
}

.icon-status-warning {
    background-image: url("../../Textures/Icons/error_200dp_FFFFFF_FILL1_wght400_GRAD0_opsz48.png");
}

/* ============================================================
   IOS TOGGLE
   ============================================================ */

.ios-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
    height: 44px;
    width: 100%;
}

.ios-toggle > .unity-toggle__label {
    flex-grow: 1;
    color: white;
    font-size: 16px;
    -unity-text-align: middle-left;
    padding-right: 20px;
    min-width: auto;
}

.ios-toggle > .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    width: 50px;
    height: 30px;
    min-width: 50px;
    min-height: 30px;
    border-radius: 15px;
    background-color: rgba(120, 120, 128, 0.32);
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.2s;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 2px;
}

.ios-toggle > .unity-toggle__input:checked {
    background-color: rgb(48, 209, 88);
}

.ios-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    min-width: 26px;
    min-height: 26px;
    border-radius: 13px;
    background-color: white;
    border-width: 0;
    margin: 0;
    padding: 0;
    background-image: none;
    align-self: flex-start;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.2s;
}

.ios-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    translate: 20px 0;
    background-image: none;
}

/* Variante "confirmation" pour les boutons de popup : fond vert TRANSLUCIDE sur le
   glass-panel (meme famille que le "Lancer" de "Calibration trouvee" et le "Oui" de la
   generation IA — rgb(46,204,113), le vert de validation de la DA), texte BLANC gras
   comme les autres boutons de popup. Se combine avec .sidebar-button : declare APRES
   lui dans ce fichier pour gagner a specificite egale. */
.popup-btn-green {
    background-color: rgba(46, 204, 113, 0.35);
    color: white;
    -unity-font-style: bold;
}

.popup-btn-green:hover {
    background-color: rgba(46, 204, 113, 0.5);
    border-color: rgba(46, 204, 113, 0.5);
}

.popup-btn-green:active {
    background-color: rgba(46, 204, 113, 0.65);
}


/* ============================================================
   Barre de défilement fine — liste de vérification ET « État du système »
   Le style par défaut d'UI Toolkit est celui de l'éditeur : large, grise, avec deux
   flèches aux extrémités. Au projecteur, elle vole l'attention à la liste elle-même.

   ⚠ La piste ET le curseur sont en POSITION ABSOLUE : le slider leur impose left/right,
   des marges ne les recentrent donc pas. On fixe la même largeur et le même left aux
   deux — seule façon de les faire coïncider quelle que soit la version d'UI Toolkit.

   Partagée par la classe `.slim-scroll` : les deux documents chargent CE fichier, une seule
   règle garantit que les deux barres restent identiques.
   ============================================================ */

/* Les flèches ne servent à rien : la liste défile seule, et au doigt. */
#devices-list .unity-scroller__low-button,
.slim-scroll .unity-scroller__low-button,
#devices-list .unity-scroller__high-button,
.slim-scroll .unity-scroller__high-button {
    display: none;
}

#devices-list .unity-scroller,
.slim-scroll .unity-scroller {
    width: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-left: 6px;
}

/* Piste et curseur : mêmes largeur, même left, mêmes coins. */
#devices-list .unity-base-slider__tracker,
.slim-scroll .unity-base-slider__tracker,
#devices-list .unity-base-slider__dragger,
.slim-scroll .unity-base-slider__dragger {
    width: 6px;
    left: 2px;
    right: auto;
    margin: 0;
    border-width: 0;
    border-radius: 3px;
}

#devices-list .unity-base-slider__tracker,
.slim-scroll .unity-base-slider__tracker {
    top: 0;
    bottom: 0;
    height: auto;
    background-color: rgba(255, 255, 255, 0.07);
}

#devices-list .unity-base-slider__dragger,
.slim-scroll .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.32);
    transition-property: background-color;
    transition-duration: 0.15s;
}

#devices-list .unity-base-slider__dragger:hover,
.slim-scroll .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.55);
}
