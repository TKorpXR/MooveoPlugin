#main-container {
    width: 100%;
    height: 100%;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 20px;
    pointer-events: none;
}

#menu-wrapper {
    position: absolute;
    top: 20px;
    left: 20px;
    flex-direction: row;
    align-items: center;
    pointer-events: auto;
}

.menu-btn {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(30, 30, 30, 0.8);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    margin: 5px;
    justify-content: center;
    align-items: center;
    transition: background-color 0.2s ease, scale 0.2s ease;
}

.menu-btn:hover {
    background-color: rgba(60, 60, 60, 0.9);
    scale: 1.05;
}

.menu-btn:active {
    scale: 0.95;
}

.anchor-btn {
    background-color: rgba(50, 150, 255, 0.8);
    border-color: rgba(255, 255, 255, 0.5);
    z-index: 10;
}

.anchor-btn:hover {
    background-color: rgb(80, 180, 255);
}



.icon-main,
.icon-recalibrate,
.icon-quit {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-main {
    background-color: rgb(255, 255, 255);
    border-radius: 20px;
    background-image: url("project://database/Assets/GraffWall/Assets/Textures/Icons/menu_200dp_FFFFFF_FILL0_wght400_GRAD0_opsz48.png?fileID=2800000&guid=3d20bcbbaa1a29a429649f4a1937de65&type=3#menu_200dp_FFFFFF_FILL0_wght400_GRAD0_opsz48");
    -unity-background-image-tint-color: rgb(27, 135, 73);
}

.icon-recalibrate {
    background-color: rgba(68, 148, 232, 0);
    background-image: url("project://database/Assets/GraffWall/Assets/Textures/Icons/home_200dp_FFFFFF_FILL1_wght400_GRAD0_opsz48.png?fileID=2800000&guid=c73dc87a664c91442b9f3007bc5dce5b&type=3#home_200dp_FFFFFF_FILL1_wght400_GRAD0_opsz48");
    -unity-background-image-tint-color: rgb(255, 165, 0);
}

.icon-quit {
    background-color: rgba(66, 145, 230, 0);
    -unity-background-image-tint-color: rgb(255, 0, 0);
    background-image: url("project://database/Assets/GraffWall/Assets/Textures/Icons/exit_to_app_200dp_FFFFFF_FILL0_wght400_GRAD0_opsz48.png?fileID=2800000&guid=16521c4847ced4a488e558de1e05a53f&type=3#exit_to_app_200dp_FFFFFF_FILL0_wght400_GRAD0_opsz48");
}
